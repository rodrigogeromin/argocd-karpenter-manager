{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Argo CD extension generation parameters",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "argoCdVersion",
    "profile"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 60
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "argoCdVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "profile": {
      "enum": [
        "resource-tab",
        "system-level",
        "status-panel",
        "top-bar-action",
        "app-view"
      ]
    },
    "hostContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceKind",
        "tag",
        "sources",
        "profile",
        "method",
        "signature",
        "props",
        "globals",
        "jsxMode",
        "argumentMap"
      ],
      "properties": {
        "sourceKind": {
          "enum": [
            "official",
            "custom"
          ]
        },
        "tag": {
          "type": "string",
          "minLength": 2
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "profile": {
          "enum": [
            "resource-tab",
            "system-level",
            "status-panel",
            "top-bar-action",
            "app-view"
          ]
        },
        "method": {
          "type": "string",
          "pattern": "^register[A-Za-z0-9]+$"
        },
        "signature": {
          "type": "string",
          "minLength": 1
        },
        "props": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "globals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "React",
              "ReactDOM",
              "ReactJSXRuntime"
            ]
          }
        },
        "jsxMode": {
          "enum": [
            "classic",
            "automatic"
          ]
        },
        "argumentMap": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "component",
              "component.flyout",
              "registration.group",
              "registration.kind",
              "registration.tabTitle",
              "registration.title",
              "registration.id",
              "registration.path",
              "registration.icon",
              "registration.iconOptions",
              "registration.isMiddle",
              "callback.shouldDisplay",
              "undefined"
            ]
          }
        },
        "flyoutProps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "react",
            "reactDom",
            "typesReact",
            "typesReactDom"
          ],
          "properties": {
            "react": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            },
            "reactDom": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            },
            "typesReact": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            },
            "typesReactDom": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            }
          }
        }
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "group": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "tabTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 80
        },
        "path": {
          "type": "string",
          "pattern": "^/[^\\s]*$",
          "maxLength": 120
        },
        "icon": {
          "type": "string",
          "maxLength": 80
        },
        "shouldDisplay": {
          "type": "boolean"
        },
        "isMiddle": {
          "type": "boolean"
        },
        "flyout": {
          "type": "boolean"
        }
      },
      "default": {}
    },
    "dataSource": {
      "enum": [
        "host-props",
        "argocd-api",
        "proxy",
        "external-api"
      ],
      "default": "host-props"
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "none",
            "proxy"
          ],
          "default": "none"
        }
      },
      "default": {}
    }
  }
}
